{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "sortImports": {
        "enabled": true
    },
    "ignorePatterns": ["dist/**", "node_modules/**", "public/assets/**"]
}
