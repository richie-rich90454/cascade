{
    "name": "cascade",
    "version": "4.0.0",
    "private": true,
    "description": "Cascade: A Century of Global Conflict, 1900-1945. An AP World History: Modern Unit 7 review game in the grand strategy tradition.",
    "license": "UNLICENSED",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "generate:svg": "tsx .opencode/tools/GenerateSvg.ts",
        "generate:midi": "tsx .opencode/tools/GenerateMidi.ts",
        "assets:placeholders": "tsx .opencode/tools/WritePlaceholder.ts",
        "assets:prompts": "tsx .opencode/tools/WriteAssetPrompt.ts",
        "assets:verify": "tsx .opencode/tools/VerifyAssets.ts",
        "assets:sync": "tsx .opencode/tools/SyncManifest.ts",
        "generate:assets": "pnpm run generate:svg && pnpm run generate:midi && pnpm run assets:placeholders && pnpm run assets:sync",
        "selfcheck": "tsx src/selfcheck/GameLogicSelfCheck.ts",
        "assets:favicon": "tsx .opencode/tools/GenerateFavicon.ts",
        "verify:visual": "tsx .opencode/tools/VerifyVisual.ts"
    },
    "dependencies": {
        "phaser": "^4.2.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "oxfmt": "^0.72.0",
        "puppeteer-core": "^25.13.0",
        "tsx": "^4.23.15",
        "typescript": "~5.9.2",
        "vite": "^8.3.4"
    }
}
